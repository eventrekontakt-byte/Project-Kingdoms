{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MFS 1.0 geometry",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "type": {
          "const": "rect"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "type": {
          "const": "point"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "points"
      ],
      "properties": {
        "type": {
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            }
          }
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "points",
        "width"
      ],
      "properties": {
        "type": {
          "const": "polyline"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "mask"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "y",
              "spans"
            ],
            "properties": {
              "y": {
                "type": "integer"
              },
              "spans": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
