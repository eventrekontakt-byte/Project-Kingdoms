{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MFS 1.0 manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "mdsVersion",
    "mapId",
    "mapRevision",
    "kind",
    "name",
    "sourceType",
    "status",
    "width",
    "height",
    "tileMeters",
    "baseTilePixels",
    "elevationStepMeters",
    "interiorScale",
    "sectorSize",
    "files",
    "interiors",
    "spawnPoints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "mdsVersion": {
      "const": "1.0"
    },
    "mapId": {
      "type": "string",
      "minLength": 1
    },
    "mapRevision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "const": "manual"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "published",
        "archived"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "tileMeters": {
      "const": 1
    },
    "baseTilePixels": {
      "const": 32
    },
    "elevationStepMeters": {
      "const": 0.5
    },
    "interiorScale": {
      "const": 2
    },
    "sectorSize": {
      "const": 16
    },
    "files": {
      "type": "object",
      "required": [
        "terrain",
        "parcels",
        "roads",
        "fortifications",
        "buildings",
        "infrastructure",
        "npcZones",
        "portals"
      ],
      "properties": {
        "terrain": {
          "type": "string",
          "minLength": 1
        },
        "parcels": {
          "type": "string",
          "minLength": 1
        },
        "roads": {
          "type": "string",
          "minLength": 1
        },
        "fortifications": {
          "type": "string",
          "minLength": 1
        },
        "buildings": {
          "type": "string",
          "minLength": 1
        },
        "infrastructure": {
          "type": "string",
          "minLength": 1
        },
        "npcZones": {
          "type": "string",
          "minLength": 1
        },
        "portals": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interiors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spawnPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sceneId",
          "x",
          "y",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
